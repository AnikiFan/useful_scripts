#!/usr/bin/env bash

set -u
set -o pipefail

DESCRIPTION='
check_user_disk_usage

扫描用户目录，找出同时满足以下条件的用户并发送邮件告警：
1. 用户目录占用空间大于系统盘当前可用空间
2. 用户目录占用空间大于最低告警阈值

可用空间通过 gdu --show-disks 获取，用户目录占用通过 gdu 非交互扫描获取，不再使用 df / du。

脚本通过状态目录记录已告警用户，在指定间隔内避免重复发送；默认每 30 天可再次提醒一次。
用户不再满足告警条件后，状态文件会被清除；再次发送成功后，状态文件时间会被刷新。
用户名与邮箱映射文件格式为每行一个 username=email@example.com。
用户目录名可以是 username，也可以带指定后缀（默认 username_data）；查找邮箱时会使用去除后缀后的用户名。

示例：
  check_user_disk_usage --mount-point / --home-root /home --min-usage-gb 100 \
    --email-map-file /etc/disk-user-emails.conf --admin-email ops@example.com

  check_user_disk_usage --no-admin-copy --msmtp-config /root/.msmtprc
'

MOUNT_POINT="/"
HOME_ROOT="/home"
USER_DIR_SUFFIX="_data"
MIN_USAGE_GB=100
ALERT_INTERVAL_DAYS=30
EMAIL_MAP_FILE="/etc/disk-user-emails.conf"
MSMTP_CONFIG="/root/.msmtprc"
STATE_DIR="/var/lib/user-disk-alert"
LOG_TAG="user-disk-monitor"
SEND_ADMIN_COPY=true
ADMIN_EMAIL="your_email@example.com"
MSMTP_BIN="msmtp"
MSMTP_RUN_USER=""
CONFIRM_BEFORE_SEND=true

usage() {
    printf '%s\n' "$DESCRIPTION"
    printf '%s\n' \
        "用法：" \
        "  check_user_disk_usage [选项]" \
        "" \
        "选项：" \
        "  -m, --mount-point PATH       用于判断可用空间的挂载点，默认：${MOUNT_POINT}" \
        "      --home-root PATH         用户目录根路径，默认：${HOME_ROOT}" \
        "      --user-dir-suffix TEXT   用户目录名后缀，默认：${USER_DIR_SUFFIX}；传入空字符串可禁用" \
        "      --min-usage-gb GB        用户占用空间最低告警阈值，单位 GB，默认：${MIN_USAGE_GB}" \
        "      --alert-interval-days DAYS  同一目录重复告警的间隔天数，默认：${ALERT_INTERVAL_DAYS}" \
        "      --email-map-file PATH    用户名与邮箱映射文件，默认：${EMAIL_MAP_FILE}" \
        "      --msmtp-config PATH      msmtp 配置文件，默认：${MSMTP_CONFIG}" \
        "      --state-dir PATH         告警状态目录，默认：${STATE_DIR}" \
        "      --log-tag TAG            syslog 日志标识，默认：${LOG_TAG}" \
        "      --admin-email EMAIL      管理员副本邮箱，默认：${ADMIN_EMAIL}" \
        "      --admin-copy             同时给管理员发送副本，默认开启" \
        "      --no-admin-copy          不给管理员发送副本" \
        "      --msmtp-bin PATH         msmtp 命令路径，默认：${MSMTP_BIN}" \
        "      --msmtp-run-user USER    使用指定系统用户执行 msmtp，默认使用当前用户" \
        "      --confirm               发送前要求用户确认，默认开启" \
        "      --no-confirm            发送前不要求用户确认" \
        "  -h, --help                   显示帮助"
}

die() {
    echo "错误：$*" >&2
    exit 1
}

is_positive_integer() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

normalize_path() {
    local path="$1"

    if [[ "$path" != "/" ]]; then
        path="${path%/}"
    fi

    if [[ -d "$path" ]]; then
        path="$(cd "$path" && pwd)"
    fi

    printf '%s\n' "$path"
}

# 将 gdu 输出中的 "126.4 GiB" / "0 B" 转成字节
gdu_size_to_bytes() {
    local size_text="$1"

    awk -v size_text="$size_text" 'BEGIN {
        n = split(size_text, parts, /[[:space:]]+/)
        i = 1
        if (n >= 1 && parts[1] == "") {
            i++
        }
        if (i > n) {
            exit 1
        }

        number = parts[i]
        unit = (i < n ? parts[i + 1] : "B")
        if (number !~ /^[0-9]+(\.[0-9]+)?$/) {
            exit 1
        }

        m = 0
        if (unit == "B") m = 1
        else if (unit == "KiB") m = 1024
        else if (unit == "MiB") m = 1024 ^ 2
        else if (unit == "GiB") m = 1024 ^ 3
        else if (unit == "TiB") m = 1024 ^ 4
        else if (unit == "PiB") m = 1024 ^ 5
        else if (unit == "EiB") m = 1024 ^ 6
        else if (unit == "kB") m = 1000
        else if (unit == "MB") m = 1000 ^ 2
        else if (unit == "GB") m = 1000 ^ 3
        else if (unit == "TB") m = 1000 ^ 4
        else if (unit == "PB") m = 1000 ^ 5
        else if (unit == "EB") m = 1000 ^ 6
        else exit 1

        printf "%.0f\n", number * m
    }'
}

# 使用 gdu -d 列出挂载盘，匹配 target 所在文件系统，输出可用字节
get_available_bytes_from_gdu() {
    local target="$1"
    local gdu_output

    gdu_output="$(gdu -ndpc 2>/dev/null)" || return 1

    awk -v target="$target" '
        function path_matches(mount, path) {
            if (mount == "/") {
                return 1
            }
            if (path == mount) {
                return 1
            }
            if (substr(path, 1, length(mount) + 1) == mount "/") {
                return 1
            }
            return 0
        }

        function to_bytes(num, unit,   m) {
            m = 0
            if (unit == "B") m = 1
            else if (unit == "KiB") m = 1024
            else if (unit == "MiB") m = 1024 ^ 2
            else if (unit == "GiB") m = 1024 ^ 3
            else if (unit == "TiB") m = 1024 ^ 4
            else if (unit == "PiB") m = 1024 ^ 5
            else if (unit == "EiB") m = 1024 ^ 6
            else if (unit == "kB") m = 1000
            else if (unit == "MB") m = 1000 ^ 2
            else if (unit == "GB") m = 1000 ^ 3
            else if (unit == "TB") m = 1000 ^ 4
            else if (unit == "PB") m = 1000 ^ 5
            else if (unit == "EB") m = 1000 ^ 6
            else return -1
            return num * m
        }

        BEGIN {
            best_len = -1
        }

        $1 == "Device" {
            next
        }

        NF < 9 {
            next
        }

        {
            mount = $9
            for (i = 10; i <= NF; i++) {
                mount = mount " " $i
            }

            if (!path_matches(mount, target)) {
                next
            }

            if ($6 !~ /^[0-9]+(\.[0-9]+)?$/) {
                next
            }

            free_bytes = to_bytes($6 + 0, $7)
            if (free_bytes < 0) {
                next
            }

            len = length(mount)
            if (len > best_len) {
                best_len = len
                best_free = free_bytes
            }
        }

        END {
            if (best_len < 0) {
                exit 1
            }
            printf "%.0f\n", best_free
        }
    ' <<< "$gdu_output"
}

# 使用 gdu 汇总扫描目录占用，输出：字节数<TAB>人类可读大小
get_dir_usage_from_gdu() {
    local target_dir="$1"
    local usage_line size_text usage_bytes

    # -n 非交互, -p 无进度, -s 只输出合计, -x 不跨越文件系统, -c 关闭颜色
    usage_line="$(gdu -npsxc "$target_dir" 2>/dev/null | tail -n 1)" || return 1

    size_text="$(
        awk '
            {
                idx = 1
                if ($1 ~ /^[^0-9.-]$/) {
                    idx = 2
                }
                if (idx + 1 > NF) {
                    exit 1
                }
                print $idx, $(idx + 1)
            }
        ' <<< "$usage_line"
    )" || return 1

    usage_bytes="$(gdu_size_to_bytes "$size_text")" || return 1
    printf '%s\t%s\n' "$usage_bytes" "$size_text"
}

while (($# > 0)); do
    case "$1" in
        -m|--mount-point)
            (($# >= 2)) || die "$1 需要一个参数"
            MOUNT_POINT="$2"
            shift 2
            ;;
        --home-root)
            (($# >= 2)) || die "$1 需要一个参数"
            HOME_ROOT="$2"
            shift 2
            ;;
        --user-dir-suffix)
            (($# >= 2)) || die "$1 需要一个参数"
            USER_DIR_SUFFIX="$2"
            shift 2
            ;;
        --min-usage-gb)
            (($# >= 2)) || die "$1 需要一个参数"
            MIN_USAGE_GB="$2"
            shift 2
            ;;
        --alert-interval-days)
            (($# >= 2)) || die "$1 需要一个参数"
            ALERT_INTERVAL_DAYS="$2"
            shift 2
            ;;
        --email-map-file)
            (($# >= 2)) || die "$1 需要一个参数"
            EMAIL_MAP_FILE="$2"
            shift 2
            ;;
        --msmtp-config)
            (($# >= 2)) || die "$1 需要一个参数"
            MSMTP_CONFIG="$2"
            shift 2
            ;;
        --state-dir)
            (($# >= 2)) || die "$1 需要一个参数"
            STATE_DIR="$2"
            shift 2
            ;;
        --log-tag)
            (($# >= 2)) || die "$1 需要一个参数"
            LOG_TAG="$2"
            shift 2
            ;;
        --admin-email)
            (($# >= 2)) || die "$1 需要一个参数"
            ADMIN_EMAIL="$2"
            shift 2
            ;;
        --admin-copy)
            SEND_ADMIN_COPY=true
            shift
            ;;
        --no-admin-copy)
            SEND_ADMIN_COPY=false
            shift
            ;;
        --msmtp-bin)
            (($# >= 2)) || die "$1 需要一个参数"
            MSMTP_BIN="$2"
            shift 2
            ;;
        --msmtp-run-user)
            (($# >= 2)) || die "$1 需要一个参数"
            MSMTP_RUN_USER="$2"
            shift 2
            ;;
        --confirm)
            CONFIRM_BEFORE_SEND=true
            shift
            ;;
        --no-confirm)
            CONFIRM_BEFORE_SEND=false
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "未知参数：$1。使用 --help 查看帮助"
            ;;
    esac
done

is_positive_integer "$MIN_USAGE_GB" || die "--min-usage-gb 必须是正整数"
is_positive_integer "$ALERT_INTERVAL_DAYS" || die "--alert-interval-days 必须是正整数"
[[ -d "$MOUNT_POINT" ]] || die "挂载点不存在：${MOUNT_POINT}"
[[ -d "$HOME_ROOT" ]] || die "用户目录根路径不存在：${HOME_ROOT}"

for command_name in gdu awk logger find basename tail hostname date mkdir stat; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        die "缺少命令：${command_name}"
    fi
done

if ! command -v "$MSMTP_BIN" >/dev/null 2>&1; then
    die "缺少 msmtp 命令：${MSMTP_BIN}"
fi

if [[ -n "$MSMTP_RUN_USER" ]] && ! command -v sudo >/dev/null 2>&1; then
    die "指定了 --msmtp-run-user，但缺少 sudo 命令"
fi

mkdir -p "$STATE_DIR"

HOSTNAME_VALUE="$(hostname -f 2>/dev/null || hostname)"
CURRENT_TIME="$(date '+%Y-%m-%d %H:%M:%S')"
MOUNT_POINT="$(normalize_path "$MOUNT_POINT")"

AVAILABLE_BYTES="$(get_available_bytes_from_gdu "$MOUNT_POINT")" || {
    logger -t "$LOG_TAG" "Unable to get available disk space"
    die "无法通过 gdu 获取 ${MOUNT_POINT} 的可用空间"
}

if [[ ! "$AVAILABLE_BYTES" =~ ^[0-9]+$ ]]; then
    logger -t "$LOG_TAG" "Unable to get available disk space"
    exit 1
fi

MIN_USAGE_BYTES=$((MIN_USAGE_GB * 1024 * 1024 * 1024))
ALERT_INTERVAL_SECONDS=$((ALERT_INTERVAL_DAYS * 24 * 60 * 60))
AVAILABLE_GB=$((AVAILABLE_BYTES / 1024 / 1024 / 1024))

get_user_email() {
    local username="$1"

    [[ -f "$EMAIL_MAP_FILE" ]] || return 1

    awk -F= -v user="$username" '
        $1 == user {
            print $2
            exit
        }
    ' "$EMAIL_MAP_FILE"
}

get_username_from_directory() {
    local directory_name="$1"

    if [[ -n "$USER_DIR_SUFFIX" ]] &&
       [[ "$directory_name" == *"$USER_DIR_SUFFIX" ]] &&
       [[ "$directory_name" != "$USER_DIR_SUFFIX" ]]; then
        printf '%s\n' "${directory_name%"$USER_DIR_SUFFIX"}"
    else
        printf '%s\n' "$directory_name"
    fi
}

send_alert() {
    local username="$1"
    local recipient="$2"
    local usage_bytes="$3"
    local usage_human="$4"
    local home_dir="$5"

    local recipients=("$recipient")
    local msmtp_args=()
    local msmtp_command=("$MSMTP_BIN")

    if [[ -n "$MSMTP_CONFIG" ]]; then
        msmtp_args+=(--file="$MSMTP_CONFIG")
    fi

    if [[ -n "$MSMTP_RUN_USER" ]]; then
        msmtp_command=(sudo -u "$MSMTP_RUN_USER" -- "$MSMTP_BIN")
    fi

    if [[ "$SEND_ADMIN_COPY" == true ]] &&
       [[ -n "$ADMIN_EMAIL" ]] &&
       [[ "$ADMIN_EMAIL" != "$recipient" ]]; then
        recipients+=("$ADMIN_EMAIL")
    fi

    {
        echo "From: Linux Disk Monitor"
        echo "To: ${recipient}"

        if [[ "$SEND_ADMIN_COPY" == true ]] &&
           [[ -n "$ADMIN_EMAIL" ]] &&
           [[ "$ADMIN_EMAIL" != "$recipient" ]]; then
            echo "Cc: ${ADMIN_EMAIL}"
        fi

        echo "Subject: [Disk Warning] Excessive disk usage on ${HOSTNAME_VALUE}"
        echo "Content-Type: text/plain; charset=UTF-8"
        echo
        echo "您好，${username}："
        echo
        echo "系统检测到您的用户目录占用空间较大，并且满足以下两个条件："
        echo
        echo "1. 您的占用空间大于系统盘当前可用空间"
        echo "2. 您的占用空间大于管理员设置的最低阈值"
        echo
        echo "主机：${HOSTNAME_VALUE}"
        echo "用户：${username}"
        echo "用户目录：${home_dir}"
        echo "您的占用空间：${usage_human}"
        echo "您的占用字节数：${usage_bytes}"
        echo "系统盘当前可用空间：${AVAILABLE_GB} GB"
        echo "最低告警阈值：${MIN_USAGE_GB} GB"
        echo "检测时间：${CURRENT_TIME}"
        echo
        echo "请您在方便时检查并清理不再需要的数据。"
        echo "如果相关数据仍需保留，也可以考虑将数据、checkpoint 或环境放置在存储服务器上，以减轻系统盘压力。"
        echo
        echo "如果您没有特殊使用说明，无需回复此邮件；如果您发现本次检测逻辑可能有误，欢迎回复说明。"
        echo
        echo "常用检查命令："
        echo "gdu -np '${home_dir}'"
        echo
        echo "祝您工作顺利。"
        echo
        echo "此邮件由服务器磁盘监控程序自动发送。"
    } | "${msmtp_command[@]}" \
        "${msmtp_args[@]}" \
        "${recipients[@]}"
}

confirm_send() {
    local username="$1"
    local recipient="$2"
    local usage_human="$3"
    local home_dir="$4"

    [[ "$CONFIRM_BEFORE_SEND" == true ]] || return 0

    if [[ ! -r /dev/tty ]]; then
        logger -t "$LOG_TAG" \
            "Alert skipped for user=${username}: confirmation requested but no terminal is available"
        return 1
    fi

    printf '%s\n' \
        "即将发送用户磁盘告警：" \
        "  发送对象 To: ${recipient}" >/dev/tty

    if [[ "$SEND_ADMIN_COPY" == true ]] &&
       [[ -n "$ADMIN_EMAIL" ]] &&
       [[ "$ADMIN_EMAIL" != "$recipient" ]]; then
        printf '  发送对象 Cc: %s\n' "$ADMIN_EMAIL" >/dev/tty
    fi

    printf '%s\n' \
        "  主机: ${HOSTNAME_VALUE}" \
        "  用户: ${username}" \
        "  用户目录: ${home_dir}" \
        "  用户占用空间: ${usage_human}" >/dev/tty
    printf '确认发送？[y/N] ' >/dev/tty

    local answer
    IFS= read -r answer </dev/tty || return 1

    case "$answer" in
        y|Y|yes|YES)
            return 0
            ;;
        *)
            logger -t "$LOG_TAG" "Alert skipped by user confirmation: user=${username}"
            return 1
            ;;
    esac
}

find "$HOME_ROOT" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -print0 |
while IFS= read -r -d '' home_dir; do
    directory_name="$(basename "$home_dir")"
    username="$(get_username_from_directory "$directory_name")"
    state_file="${STATE_DIR}/${directory_name}.alerted"

    usage_info="$(get_dir_usage_from_gdu "$home_dir" || true)"
    usage_bytes="${usage_info%%$'\t'*}"
    usage_human="${usage_info#*$'\t'}"

    if [[ ! "$usage_bytes" =~ ^[0-9]+$ || -z "$usage_human" ]]; then
        logger -t "$LOG_TAG" \
            "Unable to calculate usage for user=${username}, path=${home_dir}"
        continue
    fi

    if (( usage_bytes > AVAILABLE_BYTES &&
          usage_bytes > MIN_USAGE_BYTES )); then

        if [[ -f "$state_file" ]]; then
            current_epoch="$(date '+%s')"
            state_modified_epoch="$(stat -c '%Y' "$state_file" 2>/dev/null || true)"

            if [[ ! "$state_modified_epoch" =~ ^[0-9]+$ ]]; then
                logger -t "$LOG_TAG" \
                    "Unable to read alert state time for user=${username}, state_file=${state_file}"
                continue
            fi

            if (( state_modified_epoch > current_epoch ||
                  current_epoch - state_modified_epoch < ALERT_INTERVAL_SECONDS )); then
                logger -t "$LOG_TAG" \
                    "Alert interval not reached for user=${username}, usage=${usage_human}, state_file=${state_file}"
                continue
            fi

            logger -t "$LOG_TAG" \
                "Alert interval reached for user=${username}, usage=${usage_human}, state_file=${state_file}"
        fi

        recipient="$(get_user_email "$username" || true)"

        if [[ -z "$recipient" ]]; then
            logger -t "$LOG_TAG" \
                "No email configured for user=${username}, usage=${usage_human}"
            continue
        fi

        if confirm_send \
            "$username" \
            "$recipient" \
            "$usage_human" \
            "$home_dir"; then

            if send_alert \
                "$username" \
                "$recipient" \
                "$usage_bytes" \
                "$usage_human" \
                "$home_dir"; then

                {
                    echo "alert_time=${CURRENT_TIME}"
                    echo "usage_bytes=${usage_bytes}"
                    echo "available_bytes=${AVAILABLE_BYTES}"
                } > "$state_file"

                logger -t "$LOG_TAG" \
                    "Alert sent to ${recipient}: user=${username}, usage=${usage_human}"
            else
                logger -t "$LOG_TAG" \
                    "Failed to send alert: user=${username}, recipient=${recipient}"
            fi
        fi
    else
        if [[ -f "$state_file" ]]; then
            rm -f "$state_file"

            logger -t "$LOG_TAG" \
                "Alert cleared for user=${username}, usage=${usage_human}"
        fi
    fi
done
