#!/usr/bin/env bash

set -u
set -o pipefail

DESCRIPTION='
check_disk_space

监控指定挂载点的剩余空间。当可用空间低于阈值时发送邮件告警，并使用状态文件避免重复发送。
当空间恢复到阈值以上后，状态文件会被清除，之后再次低于阈值时会重新告警。

磁盘信息通过 gdu --show-disks 获取，不再使用 df。

示例：
  check_disk_space --mount-point / --threshold-gb 50 --recipient admin@example.com
  check_disk_space -m /data -t 200 -r ops@example.com --state-file /var/lib/disk-alert/data.alerted
'

MOUNT_POINT="/"
THRESHOLD_GB=50
RECIPIENT="xiaofan140@gmail.com"
STATE_FILE="${HOME}/.disk_space_alert_sent"
LOG_TAG="disk-monitor"
MSMTP_BIN="msmtp"
CONFIRM_BEFORE_SEND=true

usage() {
    printf '%s\n' "$DESCRIPTION"
    printf '%s\n' \
        "用法：" \
        "  check_disk_space [选项]" \
        "" \
        "选项：" \
        "  -m, --mount-point PATH    要监控的挂载点，默认：${MOUNT_POINT}" \
        "  -t, --threshold-gb GB     剩余空间告警阈值，单位 GB，默认：${THRESHOLD_GB}" \
        "  -r, --recipient EMAIL     告警收件邮箱，默认：${RECIPIENT}" \
        "  -s, --state-file PATH     告警状态文件，默认：${STATE_FILE}" \
        "      --log-tag TAG         syslog 日志标识，默认：${LOG_TAG}" \
        "      --msmtp-bin PATH      msmtp 命令路径，默认：${MSMTP_BIN}" \
        "      --confirm             发送前要求用户确认，默认开启" \
        "      --no-confirm          发送前不要求用户确认" \
        "  -h, --help                显示帮助"
}

die() {
    echo "错误：$*" >&2
    exit 1
}

is_positive_integer() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

normalize_path() {
    local path="$1"

    if [[ "$path" != "/" ]]; then
        path="${path%/}"
    fi

    if [[ -d "$path" ]]; then
        path="$(cd "$path" && pwd)"
    fi

    printf '%s\n' "$path"
}

# 从 gdu --show-disks 文本中解析 target 所在文件系统的可用字节
parse_available_bytes_from_gdu_table() {
    local target="$1"
    local gdu_output="$2"

    awk -v target="$target" '
        function path_matches(mount, path) {
            if (mount == "/") {
                return 1
            }
            if (path == mount) {
                return 1
            }
            if (substr(path, 1, length(mount) + 1) == mount "/") {
                return 1
            }
            return 0
        }

        function to_bytes(num, unit,   m) {
            m = 0
            if (unit == "B") m = 1
            else if (unit == "KiB") m = 1024
            else if (unit == "MiB") m = 1024 ^ 2
            else if (unit == "GiB") m = 1024 ^ 3
            else if (unit == "TiB") m = 1024 ^ 4
            else if (unit == "PiB") m = 1024 ^ 5
            else if (unit == "EiB") m = 1024 ^ 6
            else if (unit == "kB") m = 1000
            else if (unit == "MB") m = 1000 ^ 2
            else if (unit == "GB") m = 1000 ^ 3
            else if (unit == "TB") m = 1000 ^ 4
            else if (unit == "PB") m = 1000 ^ 5
            else if (unit == "EB") m = 1000 ^ 6
            else return -1
            return num * m
        }

        BEGIN {
            best_len = -1
        }

        $1 == "Device" {
            next
        }

        NF < 9 {
            next
        }

        {
            mount = $9
            for (i = 10; i <= NF; i++) {
                mount = mount " " $i
            }

            if (!path_matches(mount, target)) {
                next
            }

            if ($6 !~ /^[0-9]+(\.[0-9]+)?$/) {
                next
            }

            free_bytes = to_bytes($6 + 0, $7)
            if (free_bytes < 0) {
                next
            }

            len = length(mount)
            if (len > best_len) {
                best_len = len
                best_free = free_bytes
                best_free_text = $6 " " $7
            }
        }

        END {
            if (best_len < 0) {
                exit 1
            }
            printf "%.0f\t%s\n", best_free, best_free_text
        }
    ' <<< "$gdu_output"
}

while (($# > 0)); do
    case "$1" in
        -m|--mount-point)
            (($# >= 2)) || die "$1 需要一个参数"
            MOUNT_POINT="$2"
            shift 2
            ;;
        -t|--threshold-gb)
            (($# >= 2)) || die "$1 需要一个参数"
            THRESHOLD_GB="$2"
            shift 2
            ;;
        -r|--recipient)
            (($# >= 2)) || die "$1 需要一个参数"
            RECIPIENT="$2"
            shift 2
            ;;
        -s|--state-file)
            (($# >= 2)) || die "$1 需要一个参数"
            STATE_FILE="$2"
            shift 2
            ;;
        --log-tag)
            (($# >= 2)) || die "$1 需要一个参数"
            LOG_TAG="$2"
            shift 2
            ;;
        --msmtp-bin)
            (($# >= 2)) || die "$1 需要一个参数"
            MSMTP_BIN="$2"
            shift 2
            ;;
        --confirm)
            CONFIRM_BEFORE_SEND=true
            shift
            ;;
        --no-confirm)
            CONFIRM_BEFORE_SEND=false
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "未知参数：$1。使用 --help 查看帮助"
            ;;
    esac
done

is_positive_integer "$THRESHOLD_GB" || die "--threshold-gb 必须是正整数"
[[ -n "$RECIPIENT" ]] || die "--recipient 不能为空"
[[ -d "$MOUNT_POINT" ]] || die "挂载点不存在：${MOUNT_POINT}"

for command_name in gdu awk hostname date logger dirname mkdir; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        die "缺少命令：${command_name}"
    fi
done

if ! command -v "$MSMTP_BIN" >/dev/null 2>&1; then
    die "缺少 msmtp 命令：${MSMTP_BIN}"
fi

STATE_PARENT="$(dirname "$STATE_FILE")"
mkdir -p "$STATE_PARENT"

HOSTNAME_VALUE="$(hostname)"
CURRENT_TIME="$(date '+%Y-%m-%d %H:%M:%S')"
MOUNT_POINT="$(normalize_path "$MOUNT_POINT")"

GDU_DISK_TABLE="$(gdu -ndpc 2>/dev/null)" || {
    logger -t "$LOG_TAG" "Unable to get available disk space for ${MOUNT_POINT}"
    die "无法通过 gdu 获取磁盘列表"
}

AVAILABLE_INFO="$(parse_available_bytes_from_gdu_table "$MOUNT_POINT" "$GDU_DISK_TABLE")" || {
    logger -t "$LOG_TAG" "Unable to get available disk space for ${MOUNT_POINT}"
    die "无法通过 gdu 获取 ${MOUNT_POINT} 的可用空间"
}
AVAILABLE_BYTES="${AVAILABLE_INFO%%$'\t'*}"
AVAILABLE_HUMAN="${AVAILABLE_INFO#*$'\t'}"

if [[ ! "$AVAILABLE_BYTES" =~ ^[0-9]+$ || -z "$AVAILABLE_HUMAN" ]]; then
    logger -t "$LOG_TAG" "Unable to get available disk space for ${MOUNT_POINT}"
    exit 1
fi

THRESHOLD_BYTES=$((THRESHOLD_GB * 1024 * 1024 * 1024))

send_alert() {
    {
        echo "Subject: [Disk Alert] ${HOSTNAME_VALUE} 系统盘空间不足"
        echo "From: Linux Disk Monitor"
        echo "To: ${RECIPIENT}"
        echo "Content-Type: text/plain; charset=UTF-8"
        echo
        echo "服务器磁盘剩余空间已低于设定阈值。"
        echo
        echo "主机：${HOSTNAME_VALUE}"
        echo "分区：${MOUNT_POINT}"
        echo "当前剩余空间：${AVAILABLE_HUMAN}"
        echo "告警阈值：${THRESHOLD_GB} GB"
        echo "检测时间：${CURRENT_TIME}"
        echo
        echo "磁盘使用情况（gdu --show-disks）："
        printf '%s\n' "$GDU_DISK_TABLE"
    } | "$MSMTP_BIN" "$RECIPIENT"
}

confirm_send() {
    [[ "$CONFIRM_BEFORE_SEND" == true ]] || return 0

    if [[ ! -r /dev/tty ]]; then
        logger -t "$LOG_TAG" "Alert skipped: confirmation requested but no terminal is available"
        return 1
    fi

    printf '%s\n' \
        "即将发送磁盘空间告警：" \
        "  发送对象 To: ${RECIPIENT}" \
        "  主机: ${HOSTNAME_VALUE}" \
        "  分区: ${MOUNT_POINT}" \
        "  当前剩余空间: ${AVAILABLE_HUMAN}" \
        "  告警阈值: ${THRESHOLD_GB} GB" >/dev/tty
    printf '确认发送？[y/N] ' >/dev/tty

    local answer
    IFS= read -r answer </dev/tty || return 1

    case "$answer" in
        y|Y|yes|YES)
            return 0
            ;;
        *)
            logger -t "$LOG_TAG" "Alert skipped by user confirmation"
            return 1
            ;;
    esac
}

if (( AVAILABLE_BYTES < THRESHOLD_BYTES )); then
    if [[ ! -f "$STATE_FILE" ]]; then
        if confirm_send; then
            if send_alert; then
                touch "$STATE_FILE"
                logger -t "$LOG_TAG" \
                    "Disk alert sent: ${MOUNT_POINT} has ${AVAILABLE_HUMAN} available"
            else
                logger -t "$LOG_TAG" "Failed to send disk alert"
                exit 1
            fi
        fi
    fi
else
    if [[ -f "$STATE_FILE" ]]; then
        rm -f "$STATE_FILE"
        logger -t "$LOG_TAG" \
            "Disk space recovered: ${MOUNT_POINT} has ${AVAILABLE_HUMAN} available"
    fi
fi
