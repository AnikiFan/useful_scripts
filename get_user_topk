#!/usr/bin/env bash

set -u

DESCRIPTION='
get_user_topk

查看指定路径所在磁盘的剩余空间，并列出该目录下占用空间最大的前 K 个子文件夹。

磁盘信息优先通过 gdu --show-disks 获取；若无法匹配该路径所在文件系统
（例如 overlay 容器环境），则回退到 df。
子目录占用通过 gdu 非交互扫描获取，逻辑与 get_topk_storage 一致。

示例：
  get_user_topk /mnt/storage/users 10
  get_user_topk /home 5
'

usage() {
    printf '%s\n' "$DESCRIPTION"
    printf '%s\n' \
        "用法：" \
        "  get_user_topk <路径> <K>" \
        "" \
        "参数：" \
        "  路径    要检查的目录" \
        "  K       展示占用空间最大的前 K 个子文件夹" \
        "" \
        "选项：" \
        "  -h, --help    显示帮助"
}

die() {
    echo "错误：$*" >&2
    exit 1
}

is_positive_integer() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

normalize_path() {
    local path="$1"

    if [[ "$path" != "/" ]]; then
        path="${path%/}"
    fi

    if [[ -d "$path" ]]; then
        path="$(cd "$path" && pwd)"
    fi

    printf '%s\n' "$path"
}

# 从 gdu --show-disks 文本中解析 target 所在文件系统
# 输出：device<TAB>mount<TAB>size_text<TAB>used_text<TAB>free_text<TAB>used_pct
parse_disk_info_from_gdu_table() {
    local target="$1"
    local gdu_output="$2"

    awk -v target="$target" '
        function path_matches(mount, path) {
            if (mount == "/") {
                return 1
            }
            if (path == mount) {
                return 1
            }
            if (substr(path, 1, length(mount) + 1) == mount "/") {
                return 1
            }
            return 0
        }

        BEGIN {
            best_len = -1
        }

        $1 == "Device" {
            next
        }

        NF < 9 {
            next
        }

        {
            mount = $9
            for (i = 10; i <= NF; i++) {
                mount = mount " " $i
            }

            if (!path_matches(mount, target)) {
                next
            }

            if ($2 !~ /^[0-9]+(\.[0-9]+)?$/ ||
                $4 !~ /^[0-9]+(\.[0-9]+)?$/ ||
                $6 !~ /^[0-9]+(\.[0-9]+)?$/) {
                next
            }

            len = length(mount)
            if (len > best_len) {
                best_len = len
                best_device = $1
                best_mount = mount
                best_size = $2 " " $3
                best_used = $4 " " $5
                best_free = $6 " " $7
                best_pct = $8
            }
        }

        END {
            if (best_len < 0) {
                exit 1
            }
            printf "%s\t%s\t%s\t%s\t%s\t%s\n", \
                best_device, best_mount, best_size, best_used, best_free, best_pct
        }
    ' <<< "$gdu_output"
}

# 使用 df 回退解析 target 所在文件系统
parse_disk_info_from_df() {
    local target="$1"

    df -h --output=source,target,size,used,avail,pcent "$target" 2>/dev/null |
        awk '
            NR == 1 {
                next
            }
            NF < 6 {
                exit 1
            }
            {
                mount = $2
                for (i = 3; i <= NF - 4; i++) {
                    mount = mount " " $i
                }
                size = $(NF - 3)
                used = $(NF - 2)
                free = $(NF - 1)
                pct = $NF
                printf "%s\t%s\t%s\t%s\t%s\t%s\n", $1, mount, size, used, free, pct
                exit
            }
        '
}

print_disk_remaining() {
    local target="$1"
    local gdu_output disk_info device mount size_text used_text free_text used_pct

    printf '%s\n' "===== 磁盘剩余空间 ====="
    printf '路径: %s\n' "$target"

    disk_info=""
    if gdu_output="$(gdu -ndpc 2>/dev/null)"; then
        disk_info="$(parse_disk_info_from_gdu_table "$target" "$gdu_output" || true)"
    fi

    if [[ -z "$disk_info" ]]; then
        disk_info="$(parse_disk_info_from_df "$target" || true)"
    fi

    if [[ -z "$disk_info" ]]; then
        die "无法获取 ${target} 所在磁盘的剩余空间"
    fi

    IFS=$'\t' read -r device mount size_text used_text free_text used_pct <<< "$disk_info"

    printf '设备: %s\n' "$device"
    printf '挂载点: %s\n' "$mount"
    printf '总容量: %s\n' "$size_text"
    printf '已使用: %s (%s)\n' "$used_text" "$used_pct"
    printf '剩余空间: %s\n' "$free_text"
}

print_topk_dirs() {
    local target="$1"
    local k="$2"
    local table

    printf '\n%s\n' "===== 占用空间 Top ${k} ====="
    printf "%-12s %s\n" "SIZE" "DIRECTORY"
    printf "%-12s %s\n" "------------" "---------"

    # -n 非交互, -p 不显示进度, -c 关闭颜色，便于解析。
    # gdu 会按占用从大到小列出当前目录的直接子项。
    # 只保留子目录（gdu 给目录名加上了前导 /）。
    table="$(
        gdu -npc "$target" 2>/dev/null |
            awk -v k="$k" '
                {
                    idx = 1
                    # gdu 行首可能带单字符标记，例如 e 表示扫描出错
                    if ($1 ~ /^[^0-9.-]$/) {
                        idx = 2
                    }

                    num = $idx
                    unit = $(idx + 1)
                    name = $(idx + 2)
                    for (i = idx + 3; i <= NF; i++) {
                        name = name " " $i
                    }

                    if (name !~ /^\//) {
                        next
                    }
                    if (num !~ /^[0-9]+(\.[0-9]+)?$/) {
                        next
                    }
                    if (unit == "") {
                        next
                    }

                    sub(/^\//, "", name)
                    printf "%-12s %s\n", num " " unit, name

                    if (++count >= k) {
                        exit
                    }
                }
            '
    )" || die "无法扫描目录占用：${target}"

    if [[ -z "$table" ]]; then
        echo "没有找到子文件夹。"
        return
    fi

    printf '%s\n' "$table"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if [[ "$#" -ne 2 ]]; then
    usage >&2
    die "需要两个参数：<路径> <K>"
fi

TARGET_DIR="$1"
K="$2"

[[ -d "$TARGET_DIR" ]] || die "目录不存在：${TARGET_DIR}"
is_positive_integer "$K" || die "K 必须是正整数"

for command_name in gdu awk df; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        die "缺少命令：${command_name}"
    fi
done

TARGET_DIR="$(normalize_path "$TARGET_DIR")"

print_disk_remaining "$TARGET_DIR"
print_topk_dirs "$TARGET_DIR" "$K"
