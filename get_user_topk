#!/usr/bin/env bash

set -u

DESCRIPTION='
get_user_topk

查看指定路径所在磁盘的剩余空间，并列出该目录下占用空间最大的前 K 个子文件夹。

磁盘信息优先通过 gdu --show-disks 获取；若无法匹配该路径所在文件系统
（例如 overlay 容器环境），则回退到 df。
子目录占用通过 gdu 非交互扫描获取，逻辑与 get_topk_storage 一致。

示例：
  get_user_topk /mnt/storage/users 10
  get_user_topk /home 5
'

usage() {
    printf '%s\n' "$DESCRIPTION"
    printf '%s\n' \
        "用法：" \
        "  get_user_topk <路径> <K>" \
        "" \
        "参数：" \
        "  路径    要检查的目录" \
        "  K       展示占用空间最大的前 K 个子文件夹" \
        "" \
        "选项：" \
        "  -h, --help    显示帮助"
}

die() {
    printf '%s❌ 错误：%s%s\n' "$C_RED" "$*" "$C_RESET" >&2
    exit 1
}

is_positive_integer() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

# 颜色默认关闭，避免在 set -u 下未初始化；init_colors 会按终端情况开启。
C_RESET=""
C_BOLD=""
C_DIM=""
C_RED=""
C_YELLOW=""
C_CYAN=""
C_BRIGHT_RED=""
C_BRIGHT_GREEN=""
C_BRIGHT_YELLOW=""

color_is_forced() {
    case "${FORCE_COLOR:-}" in
        ''|0|false|FALSE|no|NO)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

init_colors() {
    if color_is_forced; then
        :
    elif [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
        return
    fi

    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_YELLOW=$'\033[33m'
    C_CYAN=$'\033[36m'
    C_BRIGHT_RED=$'\033[91m'
    C_BRIGHT_GREEN=$'\033[92m'
    C_BRIGHT_YELLOW=$'\033[93m'
}

# 从 "87%" / "87.4%" 中取出整数百分比；无法解析则输出空字符串。
usage_percent_int() {
    local raw="${1:-}"
    raw="${raw//%/}"
    raw="${raw// /}"
    if [[ "$raw" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf '%s\n' "${raw%%.*}"
    fi
}

# 按使用率返回状态：ok / warn / danger / critical
disk_status_level() {
    local pct="$1"

    if (( pct >= 95 )); then
        printf '%s\n' "critical"
    elif (( pct >= 85 )); then
        printf '%s\n' "danger"
    elif (( pct >= 70 )); then
        printf '%s\n' "warn"
    else
        printf '%s\n' "ok"
    fi
}

disk_status_color() {
    case "$1" in
        critical) printf '%s%s' "$C_BOLD" "$C_BRIGHT_RED" ;;
        danger)   printf '%s%s' "$C_BOLD" "$C_RED" ;;
        warn)     printf '%s%s' "$C_BOLD" "$C_BRIGHT_YELLOW" ;;
        *)        printf '%s%s' "$C_BOLD" "$C_BRIGHT_GREEN" ;;
    esac
}

disk_status_emoji() {
    case "$1" in
        critical) printf '%s\n' "🚨" ;;
        danger)   printf '%s\n' "🔴" ;;
        warn)     printf '%s\n' "⚠️" ;;
        *)        printf '%s\n' "✅" ;;
    esac
}

disk_status_hint() {
    local level="$1"
    local pct="$2"
    local free_text="$3"

    case "$level" in
        critical)
            printf '磁盘空间告急！已使用 %s%%，仅剩 %s，请立即清理。' "$pct" "$free_text"
            ;;
        danger)
            printf '磁盘空间紧张：已使用 %s%%，剩余 %s，建议尽快清理。' "$pct" "$free_text"
            ;;
        warn)
            printf '磁盘空间偏紧：已使用 %s%%，剩余 %s，请留意使用情况。' "$pct" "$free_text"
            ;;
        *)
            printf '磁盘空间充足：已使用 %s%%，剩余 %s。' "$pct" "$free_text"
            ;;
    esac
}

# 返回不带换行的用量条，便于和状态提示排在同一行。
usage_bar_string() {
    local pct="$1"
    local color="$2"
    local width="${3:-16}"
    local filled empty i
    local bar=""

    if (( pct < 0 )); then
        pct=0
    fi
    if (( pct > 100 )); then
        pct=100
    fi

    filled=$(( (pct * width + 50) / 100 ))
    if (( filled > width )); then
        filled=$width
    fi
    empty=$(( width - filled ))

    bar+="${color}"
    for ((i = 0; i < filled; i++)); do
        bar+="█"
    done
    bar+="${C_DIM}"
    for ((i = 0; i < empty; i++)); do
        bar+="░"
    done
    bar+="${C_RESET}"

    printf '%s' "$bar"
}

print_dot() {
    printf ' %s·%s ' "$C_DIM" "$C_RESET"
}

normalize_path() {
    local path="$1"

    if [[ "$path" != "/" ]]; then
        path="${path%/}"
    fi

    if [[ -d "$path" ]]; then
        path="$(cd "$path" && pwd)"
    fi

    printf '%s\n' "$path"
}

# 从 gdu --show-disks 文本中解析 target 所在文件系统
# 输出：device<TAB>mount<TAB>size_text<TAB>used_text<TAB>free_text<TAB>used_pct
parse_disk_info_from_gdu_table() {
    local target="$1"
    local gdu_output="$2"

    awk -v target="$target" '
        function path_matches(mount, path) {
            if (mount == "/") {
                return 1
            }
            if (path == mount) {
                return 1
            }
            if (substr(path, 1, length(mount) + 1) == mount "/") {
                return 1
            }
            return 0
        }

        BEGIN {
            best_len = -1
        }

        $1 == "Device" {
            next
        }

        NF < 9 {
            next
        }

        {
            mount = $9
            for (i = 10; i <= NF; i++) {
                mount = mount " " $i
            }

            if (!path_matches(mount, target)) {
                next
            }

            if ($2 !~ /^[0-9]+(\.[0-9]+)?$/ ||
                $4 !~ /^[0-9]+(\.[0-9]+)?$/ ||
                $6 !~ /^[0-9]+(\.[0-9]+)?$/) {
                next
            }

            len = length(mount)
            if (len > best_len) {
                best_len = len
                best_device = $1
                best_mount = mount
                best_size = $2 " " $3
                best_used = $4 " " $5
                best_free = $6 " " $7
                best_pct = $8
            }
        }

        END {
            if (best_len < 0) {
                exit 1
            }
            printf "%s\t%s\t%s\t%s\t%s\t%s\n", \
                best_device, best_mount, best_size, best_used, best_free, best_pct
        }
    ' <<< "$gdu_output"
}

# 使用 df 回退解析 target 所在文件系统
parse_disk_info_from_df() {
    local target="$1"

    df -h --output=source,target,size,used,avail,pcent "$target" 2>/dev/null |
        awk '
            NR == 1 {
                next
            }
            NF < 6 {
                exit 1
            }
            {
                mount = $2
                for (i = 3; i <= NF - 4; i++) {
                    mount = mount " " $i
                }
                size = $(NF - 3)
                used = $(NF - 2)
                free = $(NF - 1)
                pct = $NF
                printf "%s\t%s\t%s\t%s\t%s\t%s\n", $1, mount, size, used, free, pct
                exit
            }
        '
}

print_disk_remaining() {
    local target="$1"
    local gdu_output disk_info device mount size_text used_text free_text used_pct
    local pct_int level color emoji hint

    disk_info=""
    if gdu_output="$(gdu -ndpc 2>/dev/null)"; then
        disk_info="$(parse_disk_info_from_gdu_table "$target" "$gdu_output" || true)"
    fi

    if [[ -z "$disk_info" ]]; then
        disk_info="$(parse_disk_info_from_df "$target" || true)"
    fi

    if [[ -z "$disk_info" ]]; then
        die "无法获取 ${target} 所在磁盘的剩余空间"
    fi

    IFS=$'\t' read -r device mount size_text used_text free_text used_pct <<< "$disk_info"

    pct_int="$(usage_percent_int "$used_pct")"
    if [[ -n "$pct_int" ]]; then
        level="$(disk_status_level "$pct_int")"
        color="$(disk_status_color "$level")"
        emoji="$(disk_status_emoji "$level")"
        hint="$(disk_status_hint "$level" "$pct_int" "$free_text")"
    else
        color="$C_BOLD$C_CYAN"
    fi

    printf '%s💾 磁盘剩余空间%s' "$C_BOLD$C_CYAN" "$C_RESET"
    print_dot
    printf '%s📂%s %s\n' "$C_DIM" "$C_RESET" "$target"

    if [[ -n "$pct_int" ]]; then
        printf '  %s%s %s%s  %s %s%d%%%s\n' \
            "$color" "$emoji" "$hint" "$C_RESET" \
            "$(usage_bar_string "$pct_int" "$color")" \
            "$color" "$pct_int" "$C_RESET"
    fi

    printf '  %s💿%s %s %s@%s %s' "$C_DIM" "$C_RESET" "$device" "$C_DIM" "$C_RESET" "$mount"
    print_dot
    printf '%s📦%s 总 %s' "$C_DIM" "$C_RESET" "$size_text"
    print_dot
    printf '%s📊%s 已用 %s%s%s' "$C_DIM" "$C_RESET" "$color" "${used_text} (${used_pct})" "$C_RESET"
    print_dot
    printf '%s🆓%s 剩 %s%s%s\n' "$C_DIM" "$C_RESET" "$color" "$free_text" "$C_RESET"
}

print_topk_row() {
    local rank="$1"
    local size="$2"
    local name="$3"
    local badge size_padded size_color name_color

    printf -v size_padded "%-12s" "$size"

    case "$rank" in
        1)
            badge="🥇"
            size_color="$C_BOLD$C_BRIGHT_YELLOW"
            name_color="$C_BOLD"
            ;;
        2)
            badge="🥈"
            size_color="$C_BOLD$C_CYAN"
            name_color=""
            ;;
        3)
            badge="🥉"
            size_color="$C_YELLOW"
            name_color=""
            ;;
        *)
            printf -v badge "%2d." "$rank"
            size_color="$C_CYAN"
            name_color=""
            ;;
    esac

    printf '  %s  %s%s%s %s%s%s\n' \
        "$badge" \
        "$size_color" "$size_padded" "$C_RESET" \
        "$name_color" "$name" "$C_RESET"
}

print_topk_dirs() {
    local target="$1"
    local k="$2"
    local table rank size name

    printf '\n%s🏆 占用空间 Top %s%s\n' "$C_BOLD$C_CYAN" "$k" "$C_RESET"

    # -n 非交互, -p 不显示进度, -c 关闭颜色，便于解析。
    # gdu 会按占用从大到小列出当前目录的直接子项。
    # 只保留子目录（gdu 给目录名加上了前导 /）。
    table="$(
        gdu -npc "$target" 2>/dev/null |
            awk -v k="$k" '
                {
                    idx = 1
                    # gdu 行首可能带单字符标记，例如 e 表示扫描出错
                    if ($1 ~ /^[^0-9.-]$/) {
                        idx = 2
                    }

                    num = $idx
                    unit = $(idx + 1)
                    name = $(idx + 2)
                    for (i = idx + 3; i <= NF; i++) {
                        name = name " " $i
                    }

                    if (name !~ /^\//) {
                        next
                    }
                    if (num !~ /^[0-9]+(\.[0-9]+)?$/) {
                        next
                    }
                    if (unit == "") {
                        next
                    }

                    sub(/^\//, "", name)
                    printf "%s\t%s\n", num " " unit, name

                    if (++count >= k) {
                        exit
                    }
                }
            '
    )" || die "无法扫描目录占用：${target}"

    if [[ -z "$table" ]]; then
        printf '  %s📭 没有找到子文件夹。%s\n' "$C_DIM" "$C_RESET"
        return
    fi

    rank=0
    while IFS=$'\t' read -r size name; do
        rank=$((rank + 1))
        print_topk_row "$rank" "$size" "$name"
    done <<< "$table"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    init_colors

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    if [[ "$#" -ne 2 ]]; then
        usage >&2
        die "需要两个参数：<路径> <K>"
    fi

    TARGET_DIR="$1"
    K="$2"

    [[ -d "$TARGET_DIR" ]] || die "目录不存在：${TARGET_DIR}"
    is_positive_integer "$K" || die "K 必须是正整数"

    for command_name in gdu awk df; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            die "缺少命令：${command_name}"
        fi
    done

    TARGET_DIR="$(normalize_path "$TARGET_DIR")"

    print_disk_remaining "$TARGET_DIR"
    print_topk_dirs "$TARGET_DIR" "$K"
fi
